{
  "info": {
    "name": "CRM-TOYOTA — Auditoría QA Caja Negra (v1.0)",
    "_postman_id": "d84c9120-5e19-4f7a-9b18-crmtoyota2026",
    "description": "Colección oficial exportable para auditoría QA (Aaron Felices). Cubre RBAC (ADMIN, RECEPCIONISTA, ALMACEN), Ley 29733, Stock Atómico (@Version), Conflicto 409 + Equivalentes, PDF < 3s y Dashboard ML Batch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "mlUrl", "value": "http://localhost:8000" },
    { "key": "jwt_admin", "value": "" },
    { "key": "jwt_recep", "value": "" },
    { "key": "jwt_almacen", "value": "" },
    { "key": "created_quote_id", "value": "6" }
  ],
  "item": [
    {
      "name": "01 - Auth & Roles (JWT 14h)",
      "item": [
        {
          "name": "Login RECEPCIONISTA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 y latencia < 2000ms', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jwt_recep', body.accessToken);",
                  "pm.test('Tope descuento Recepcionista = 5%', () => pm.expect(body.maxDiscountPercent).to.eql(5));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"recepcion\",\"password\":\"Toyota2026!\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('jwt_admin', pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"Toyota2026!\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login ALMACEN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('jwt_almacen', pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"almacen\",\"password\":\"Toyota2026!\"}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "02 - Clientes (Ley 29733) & Vehículos Toyota",
      "item": [
        {
          "name": "Rechazo 400 sin Consentimiento Ley 29733",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Bloquea registro sin consentimiento (400)', () => pm.response.to.have.status(400));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_recep}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"documentType\":\"DNI\",\"documentNumber\":\"71223344\",\"fullName\":\"Prueba Sin Ley\",\"phone\":\"987112233\",\"dataConsentAccepted\":false}"
            },
            "url": "{{baseUrl}}/api/v1/customers"
          }
        },
        {
          "name": "Búsqueda Instantánea POS por Placa + Kit Sugerido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 y < 500ms', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test('Incluye Kit Yaris 40k', () => pm.expect(pm.response.json()[0].suggestedPreventiveKit.code).to.eql('KIT-YARIS-40K'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_recep}}" }],
            "url": "{{baseUrl}}/api/v1/vehicles?q=ABC-123"
          }
        }
      ]
    },
    {
      "name": "03 - Cotizador Atómico, Conflicto 409 & PDF < 3s",
      "item": [
        {
          "name": "Intentar Aprobar COT-2026-00042 sin Stock (Espera 409 + Equivalentes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Bloquea con HTTP 409 INSUFFICIENT_STOCK sin pasar a rechazada', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('INSUFFICIENT_STOCK');",
                  "  pm.expect(pm.response.json().conflicts[0].compatibleEquivalents.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_recep}}" }],
            "url": "{{baseUrl}}/api/v1/quotes/6/approve"
          }
        },
        {
          "name": "Descargar Proforma PDF (< 3000ms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('PDF generado en < 3000ms', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_recep}}" }],
            "url": "{{baseUrl}}/api/v1/quotes/6/pdf"
          }
        }
      ]
    },
    {
      "name": "04 - Dashboard ML Batch (< 500ms) & Microservicio FastAPI",
      "item": [
        {
          "name": "GET Dashboard Alertas desde PostgreSQL (< 500ms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 y lectura < 500ms', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_almacen}}" }],
            "url": "{{baseUrl}}/api/v1/forecasts/dashboard"
          }
        },
        {
          "name": "GET /metrics Directo en Microservicio ML (R2 >= 0.80, WAPE <= 15%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cumple umbrales PMBOK demanda intermitente', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const m = pm.response.json();",
                  "  pm.expect(m.targets_met.r2).to.eql(true);",
                  "  pm.expect(m.targets_met.wape).to.eql(true);",
                  "  pm.expect(m.targets_met.mape_positive).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mlUrl}}/metrics"
          }
        }
      ]
    }
  ]
}
